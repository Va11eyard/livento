# Livento environment variables.
# Copy to .env.local for local development. Every variable is optional:
# without a key, each feature falls back to labeled sample data or rule-based text.
# All keys are server-side only — never prefix a secret with NEXT_PUBLIC_.

# --- Live events -------------------------------------------------------------
# Ticketmaster Discovery API key (free): https://developer.ticketmaster.com/
# Default quota: 5,000 calls/day, 5 requests/second. Results are cached 1 hour.
TICKETMASTER_API_KEY=

# --- LLM ---------------------------------------------------------------------
# Anthropic API key: https://platform.claude.com/
# Used for re-ranking recommendations, roadmap wording and ambiguous spend lines.
# Model: claude-opus-5-5. The LLM never produces prices or dates.
ANTHROPIC_API_KEY=
# Google Gemini API key (backup AI): https://aistudio.google.com/apikey
# Used when ANTHROPIC_API_KEY is missing, or when Claude fails for account reasons
# (credit balance, auth, outage); Claude is then skipped for 10 minutes.
# Web event search on Gemini uses Grounding with Google Search: paid tier only.
GEMINI_API_KEY=
# Optional model override (default: gemini-3.6-flash).
GEMINI_MODEL=

# --- Payments (TEST MODE ONLY) ------------------------------------------------
# Stripe secret key that starts with sk_test_ (live keys are refused by the app).
# Without it, /api/checkout returns { demo: true } and the UI offers "Demo unlock".
STRIPE_SECRET_KEY=

# --- Telegram alerts -----------------------------------------------------------
# Bot token and username from @BotFather (username without the @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: secret checked against the X-Telegram-Bot-Api-Secret-Token header.
# Pass the same value as secret_token when you call setWebhook (see README).
TELEGRAM_WEBHOOK_SECRET=

# --- Email alerts --------------------------------------------------------------
# Resend API key (https://resend.com/) and a sender on a domain you verified there,
# e.g. "Livento <alerts@yourdomain.com>".
RESEND_API_KEY=
ALERTS_FROM_EMAIL=

# --- Storage (alert subscriptions, event cache, rate limits, interaction log) ---
# Upstash Redis REST credentials (free tier). Vercel's Upstash integration sets these.
# Without them an in-memory store is used (per server instance; alerts are disabled).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron --------------------------------------------------------------------
# Protects GET /api/cron/alerts. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Links -------------------------------------------------------------------
# Public site URL used for absolute links in emails and checkout return URLs,
# e.g. https://livento.vercel.app (no trailing slash).
NEXT_PUBLIC_SITE_URL=
